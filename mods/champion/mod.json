{
  "id": "champion",
  "name": "Wandering Champion",
  "version": "1.0.0",
  "description": "Every so often, while you are outdoors at night, a champion (a mini-boss at your level and above) appears 80-150 m away and roams. The screen shows how far it is and where; slay it for a bonus. A gameplay mod in Lua: change main.lua while the game runs.",
  "authors": ["EMF"],
  "enabled": false,
  "emf": 14,
  "main": "main.lua",
  "depends": {"lua": ">=1.4"},
  "settings": [
    {"key": "interval_minutes", "type": "slider", "min": 5, "max": 120, "step": 5, "default": 20,
     "label": "A chance every (minutes outdoors)", "live": true, "group": "When"},
    {"key": "chance", "type": "slider", "min": 0, "max": 100, "step": 5, "default": 50, "label": "Chance (%)",
     "live": true, "group": "When"},
    {"key": "night_only", "type": "bool", "default": true, "label": "Only at night", "live": true, "group": "When",
     "help": "At night (18:00-6:00) only; it fades at dawn."},
    {"key": "lifetime_minutes", "type": "slider", "min": 2, "max": 30, "step": 1, "default": 10,
     "label": "It leaves after (minutes)", "live": true, "group": "When"},
    {"key": "level_bonus", "type": "slider", "min": -5, "max": 10, "step": 1, "default": 2,
     "label": "Levels above the player", "live": true, "group": "Champion"},
    {"key": "reward_item", "type": "text", "default": "Weapon_T1_1H_SwordEpic_01", "maxLength": 96,
     "label": "Bonus item", "live": true, "group": "Champion",
     "help": "Its debug name (items sword in the console); empty = none. Gear comes at the slayer's level."},
    {"key": "reward_count", "type": "slider", "min": 1, "max": 20, "step": 1, "default": 1, "label": "How many",
     "live": true, "group": "Champion"},
    {"key": "reward_rarity", "type": "select", "default": "rare", "label": "Its rarity", "live": true,
     "group": "Champion",
     "options": [{"value": "default", "label": "The game's choice"}, {"value": "common", "label": "Common"},
                 {"value": "uncommon", "label": "Uncommon"}, {"value": "rare", "label": "Rare"},
                 {"value": "epic", "label": "Epic"}, {"value": "legendary", "label": "Legendary"}]},
    {"key": "hud", "type": "bool", "default": true, "label": "Show where it is", "live": true, "group": "Screen"},
    {"key": "corner", "type": "select", "default": "top_right", "label": "Corner", "live": true, "group": "Screen",
     "enabledWhen": {"setting": "hud", "equals": true},
     "options": [{"value": "top_right", "label": "Top right"}, {"value": "bottom_right", "label": "Bottom right"},
                 {"value": "bottom_left", "label": "Bottom left"}]},
    {"key": "color", "type": "color", "default": "#ffd070", "label": "Colour", "live": true, "group": "Screen",
     "enabledWhen": {"setting": "hud", "equals": true}}
  ]
}
