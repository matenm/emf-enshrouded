{
  "id": "bounty",
  "name": "Bounty Board",
  "version": "1.0.0",
  "description": "Daily bounties for every player: slay creatures of a faction, gather a material, slay a champion; rewards with /bounty.claim. /bounty.board shows yours, also from the game's chat. Kept per world and per player. Host or dedicated server; players who join need nothing. A Lua mod: the bounties are a table at the top of main.lua, or your own in emf\\config\\bounty\\pool.lua (kept when EMF is installed again). Installed switched off.",
  "authors": ["EMF"],
  "enabled": false,
  "emf": 14,
  "side": "server",
  "main": "main.lua",
  "depends": {"lua": ">=1.4"},
  "settings": [
    {"key": "bounties_per_period", "type": "slider", "min": 1, "max": 5, "step": 1, "default": 3,
     "label": "Bounties per player", "live": true, "group": "Bounties"},
    {"key": "difficulty", "type": "select", "default": "normal", "label": "How many to slay or gather", "live": true,
     "group": "Bounties",
     "options": [{"value": "easy", "label": "Easy (x0.6)"}, {"value": "normal", "label": "Normal"},
                 {"value": "hard", "label": "Hard (x1.5)"}],
     "help": "For bounties drawn from now on."},
    {"key": "share_kills", "type": "bool", "default": true, "label": "Shared kills", "live": true, "group": "Bounties",
     "help": "A kill counts for every player who hit the creature in its last 10 s (off: only the last hit)."},
    {"key": "reset", "type": "select", "default": "real_day", "label": "New bounties", "live": true, "group": "Period",
     "options": [{"value": "real_day", "label": "Every day at an hour (the host's clock)"},
                 {"value": "game_dawn", "label": "Every dawn in the game"},
                 {"value": "hours", "label": "Every few hours of play"}]},
    {"key": "reset_hour", "type": "slider", "min": 0, "max": 23, "step": 1, "default": 6, "label": "At (hour)",
     "live": true, "group": "Period", "enabledWhen": {"setting": "reset", "equals": "real_day"}},
    {"key": "reset_hours", "type": "slider", "min": 1, "max": 24, "step": 1, "default": 4, "label": "Every (hours of play)",
     "live": true, "group": "Period", "enabledWhen": {"setting": "reset", "equals": "hours"}},
    {"key": "rerolls", "type": "slider", "min": 0, "max": 3, "step": 1, "default": 1, "label": "Rerolls per period",
     "live": true, "group": "Period"},
    {"key": "auto_claim", "type": "bool", "default": false, "label": "Rewards come at once", "live": true,
     "group": "Rewards", "help": "Off: /bounty.claim collects them."},
    {"key": "reward_scale", "type": "slider", "min": 0.5, "max": 3, "step": 0.5, "default": 1, "label": "Reward amounts (x)",
     "live": true, "group": "Rewards"},
    {"key": "reward_rarity", "type": "select", "default": "uncommon", "label": "Gear rewards' rarity", "live": true,
     "group": "Rewards",
     "options": [{"value": "default", "label": "The game's choice"}, {"value": "common", "label": "Common"},
                 {"value": "uncommon", "label": "Uncommon"}, {"value": "rare", "label": "Rare"},
                 {"value": "epic", "label": "Epic"}, {"value": "legendary", "label": "Legendary"}],
     "help": "Gear comes at the player's level."},
    {"key": "hud", "type": "bool", "default": true, "label": "Show your bounties", "live": true, "group": "Screen",
     "help": "The host's own; players who joined use /bounty.board."},
    {"key": "corner", "type": "select", "default": "bottom_left", "label": "Corner", "live": true, "group": "Screen",
     "enabledWhen": {"setting": "hud", "equals": true},
     "options": [{"value": "top_right", "label": "Top right"}, {"value": "bottom_right", "label": "Bottom right"},
                 {"value": "bottom_left", "label": "Bottom left"}]},
    {"key": "color", "type": "color", "default": "#e0c080", "label": "Colour", "live": true, "group": "Screen",
     "enabledWhen": {"setting": "hud", "equals": true}}
  ]
}
