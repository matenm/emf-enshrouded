{
  "id": "beastmaster",
  "name": "Beastmaster",
  "version": "1.1.0",
  "description": "A Beastmaster class: tame wild wolves, boars, sabretooths, hounds, and with the content packs bears, aurochs and panthers (beat them down or feed them bait), keep up to 8 in your collection, call up to 2 to fight beside you. They follow you, come back when far away, and are kept with the world. Hold B for the beast wheel; /beastmaster in the chat for players who join. Host or dedicated server. Installed switched off.",
  "authors": ["EMF contributors"],
  "enabled": false,
  "emf": 14,
  "side": "server",
  "main": "main.lua",
  "depends": {"lua": ">=1.9"},
  "settings": [
    {"key": "wheel_key", "type": "keybind", "default": "B", "label": "Beast wheel (hold)", "live": true, "group": "Controls"},
    {"key": "shared_wheel", "type": "bool", "default": true, "label": "One wheel with Necromancer's undead (when both are installed)", "live": true, "group": "Controls"},
    {"key": "call_mana_pct", "type": "slider", "min": 0, "max": 50, "step": 1, "default": 15, "label": "Mana to call a beast (% of max)", "live": true, "group": "Calling"},
    {"key": "call_cooldown_s", "type": "slider", "min": 0, "max": 60, "step": 1, "default": 10, "label": "Seconds between calls", "live": true, "group": "Calling"},
    {"key": "max_out", "type": "slider", "min": 1, "max": 4, "step": 1, "default": 2, "label": "Beasts out at once", "live": true, "group": "Calling"},
    {"key": "rest_s", "type": "slider", "min": 0, "max": 600, "step": 10, "default": 120, "label": "Rest after a beast falls (s)", "live": true, "group": "Calling"},
    {"key": "collection_max", "type": "slider", "min": 1, "max": 16, "step": 1, "default": 8, "label": "Beasts in your collection", "live": true, "group": "Calling"},
    {"key": "tame_health_pct", "type": "slider", "min": 5, "max": 100, "step": 5, "default": 25, "label": "Tame by defeat below (% health)", "live": true, "group": "Taming"},
    {"key": "tame_channel_s", "type": "slider", "min": 1, "max": 10, "step": 1, "default": 3, "label": "Taming takes (s)", "live": true, "group": "Taming"},
    {"key": "tame_range_m", "type": "slider", "min": 3, "max": 20, "step": 1, "default": 8, "label": "Taming range (m)", "live": true, "group": "Taming"},
    {"key": "feed_count", "type": "slider", "min": 1, "max": 10, "step": 1, "default": 3, "label": "Baits to tame by feeding", "live": true, "group": "Taming"},
    {"key": "feed_window_s", "type": "slider", "min": 5, "max": 60, "step": 1, "default": 10, "label": "Feeding window (s)", "live": true, "group": "Taming"},
    {"key": "bait_wolf", "type": "text", "default": "Food_T2_Dog_Bait", "label": "Bait for wolves", "live": true, "group": "Taming"},
    {"key": "bait_hound", "type": "text", "default": "Food_T2_Dog_Bait", "label": "Bait for hounds", "live": true, "group": "Taming"},
    {"key": "bait_boar", "type": "text", "default": "Food_T1_raw_bad_meat_LeanMeat", "label": "Bait for boars", "live": true, "group": "Taming"},
    {"key": "bait_sabretooth", "type": "text", "default": "Food_T2_raw_bad_meat_Game", "label": "Bait for sabretooths", "live": true, "group": "Taming"},
    {"key": "bait_bear", "type": "text", "default": "Food_T1_raw_fruit_Red_Berries", "label": "Bait for bears", "live": true, "group": "Taming"},
    {"key": "bait_aurochs", "type": "text", "default": "Food_T1_raw_fruit_Red_Berries", "label": "Bait for aurochs", "live": true, "group": "Taming"},
    {"key": "bait_panther", "type": "text", "default": "Food_T2_raw_bad_meat_Game", "label": "Bait for panthers", "live": true, "group": "Taming"},
    {"key": "leash_m", "type": "slider", "min": 15, "max": 100, "step": 5, "default": 40, "label": "Beasts come back from (m)", "live": true, "group": "Behaviour"},
    {"key": "leash_far_m", "type": "slider", "min": 30, "max": 300, "step": 10, "default": 80, "label": "At once from (m)", "live": true, "group": "Behaviour"},
    {"key": "xp_credit", "type": "bool", "default": true, "label": "You get your beasts' kills (XP and loot)", "live": true, "group": "Behaviour"},
    {"key": "wild_bears", "type": "bool", "default": true, "label": "Rare wild bears, aurochs and panthers (needs their content pack)", "live": true, "group": "World"},
    {"key": "wild_bear_minutes", "type": "slider", "min": 5, "max": 120, "step": 5, "default": 30, "label": "A wild pack beast about every (minutes)", "live": true, "group": "World"}
  ]
}
