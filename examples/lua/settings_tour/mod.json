{
  "id": "settings_tour",
  "name": "Settings Tour",
  "version": "1.0.0",
  "description": "One setting of every kind in the Mods tab, shown on screen while you change them. An EMF example mod in Lua.",
  "authors": ["EMF"],
  "emf": 14,
  "main": "main.lua",
  "depends": {"lua": ">=1.3"},
  "settings": [
    {"key": "show", "type": "bool", "default": true, "label": "Show the values on screen", "live": true},
    {"key": "greeting", "type": "text", "default": "Welcome to the settings tour", "maxLength": 40,
     "label": "Greeting when the mod starts",
     "help": "Not live: the mod reads it once when it loads, so the Mods tab says \"next start\"."},

    {"key": "count", "type": "int", "default": 3, "min": 0, "label": "A whole number (a number box)", "live": true,
     "group": "Numbers"},
    {"key": "scale", "type": "float", "default": 1.5, "label": "A decimal number (a number box)", "live": true,
     "group": "Numbers"},
    {"key": "volume", "type": "slider", "min": 0, "max": 1, "step": 0.05, "default": 0.5,
     "label": "A decimal slider", "live": true, "group": "Numbers"},

    {"key": "mood", "type": "choice", "choices": ["calm", "busy", "wild"], "default": "calm",
     "label": "A list (choice: read as its number)", "live": true, "group": "Lists"},
    {"key": "wildness", "type": "slider", "min": 1, "max": 10, "step": 1, "default": 5,
     "label": "A whole-number slider", "help": "Greyed out unless the mood is wild.", "live": true, "group": "Lists",
     "enabledWhen": {"setting": "mood", "equals": "wild"}},
    {"key": "corner", "type": "select", "default": "bottom_left", "label": "A list (select: read as its value)",
     "live": true, "group": "Lists",
     "options": [{"value": "top_right", "label": "Top right"}, {"value": "bottom_right", "label": "Bottom right"},
                 {"value": "bottom_left", "label": "Bottom left"}],
     "enabledWhen": {"setting": "show", "equals": true}},

    {"key": "color", "type": "color", "default": "#80d0ff", "label": "A colour", "live": true, "group": "Look",
     "enabledWhen": {"setting": "show", "equals": true}},
    {"key": "label", "type": "text", "default": "Tour", "maxLength": 12, "label": "A text (at most 12 characters)",
     "live": true, "group": "Look", "enabledWhen": {"setting": "show", "equals": true}},

    {"key": "mood_key", "type": "keybind", "default": "F4", "label": "A key (it changes the mood)",
     "help": "Click it, then press a key.", "live": true, "group": "Keys"}
  ]
}
